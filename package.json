{
  "name": "shogi-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "自分用の将棋棋譜アトラス。棋譜の収集・分類・局面検索を行う PWA。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "inbox": "tsx scripts/process-inbox.ts",
    "reindex": "tsx scripts/reindex.ts",
    "e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "analyze": "tsx scripts/analyze.ts",
    "build-profiles": "tsx scripts/profile.ts"
  },
  "dependencies": {
    "@mizarjp/yaneuraou.k-p": "7.6.3-alpha.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsshogi": "^2.3.4",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/emscripten": "^1.41.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.0.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
